# github.private-key-file="/absolute/private/controller-app.pem"
# github.repository=["owner/source=NUMERIC_REPOSITORY_ID", "owner/worker=NUMERIC_REPOSITORY_ID"]

web.local.host="127.0.0.1"
web.local.port=8080
ui.origin="http://127.0.0.1:8080"

