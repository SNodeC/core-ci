# Example only: replace every value before operator-managed deployment.
[coreci]
registry=SNodeC/Packages:ci/registry.json
target-catalog=ci/targets.json
workflow-repository=SNodeC/Packages
feed-branch=feed
wave-delay=120
wave-deadline=23400
publication-deadline=23400
start-timeout=900
retry-delay=600
max-dispatch-attempts=8
reconcile-interval=900
github-app-id="REPLACE_WITH_APP_ID"
github-installation-id="REPLACE_WITH_INSTALLATION_ID"
github-app-key-file="REPLACE_WITH_RSA_PEM_PATH"
callback-base-url="REPLACE_WITH_PUBLIC_HTTPS_BASE_URL"
db-host="REPLACE_WITH_DATABASE_HOST"
db-user="REPLACE_WITH_DATABASE_USER"
db-name="REPLACE_WITH_DATABASE_NAME"
db-password-file="/etc/coreci/database-password"
webhook-secret-file="/etc/coreci/webhook-secret"
callback-secret-file="/etc/coreci/callback-secret"
idp-base-url="REPLACE_WITH_IDP_HTTPS_BASE_URL"
idp-client-id="REPLACE_WITH_IDP_CLIENT_ID"
idp-public-key-path="REPLACE_WITH_IDP_PUBLIC_KEY_PATH"
dashboard-users="REPLACE_WITH_ALLOWED_IDP_SUBJECTS"

[coreci.local]
host="0.0.0.0"
port=8443

[coreci.tls]
cert="REPLACE_WITH_CERTIFICATE_PATH"
cert-key="REPLACE_WITH_PRIVATE_KEY_PATH"

[coreci.socket]
reuse-address=true

[coreci.http.parser]
maximum-body-bytes=26214400
maximum-header-bytes=65536
maximum-header-fields=100
maximum-start-line-bytes=8192

[coreci-redirect]
disabled=true

[coreci-redirect.local]
host="0.0.0.0"
port=8080
# Set disabled=false above to enable this optional listener.
